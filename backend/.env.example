PORT=3100
NODE_ENV=development
API_PREFIX=api/v1
APP_NAME=FibroSync API
APP_VERSION=1.0.0
SWAGGER_PATH=docs
# Comma-separated origins. Do not include trailing slashes.
FRONTEND_URL=http://localhost:5173,https://fibrosync.com,https://www.fibrosync.com,https://*.vercel.app
# Connect to Postgres via the Supabase transaction-mode pooler (used by Prisma in this backend)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the Supabase session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET=change_me_to_a_strong_access_secret_with_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_to_a_strong_refresh_secret_with_32_chars
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PREDICTION_LOOKBACK_DAYS=21
AI_PATTERN_ANALYSIS_LOOKBACK_DAYS=30
AI_PREDICTION_PROMPT_VERSION=v1
OPENAI_API_KEY=
# Used only by `prisma/seed.ts` to create/update the ADMIN account. There is
# no default password: ADMIN_SEED_PASSWORD is REQUIRED for the seed to run
# and must be a strong, unique value (>= 12 chars, upper+lowercase, a digit
# and a symbol). Never commit a real value here.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=FibroSync Admin
